---
import ThemeSwitcher from './ThemeSwitcher.astro';

interface Props {
  active: 'home' | 'about' | 'experience' | 'projects';
}
const { active } = Astro.props;
const base = import.meta.env.BASE_URL;

const links = [
  { id: 'home', href: base, label: 'Home' },
  { id: 'about', href: `${base}about`, label: 'About' },
  { id: 'experience', href: `${base}experience`, label: 'Experience' },
  { id: 'projects', href: `${base}projects`, label: 'Projects' },
  { id: 'contact', href: `${base}#contact`, label: 'Contact' },
];
---

<nav class="site-nav" aria-label="Primary">
  <div class="container">
    <a class="brand" href={base}>Sudarshana Chaitanya B N</a>
    <div class="nav-controls">
      <ul>
        {
          links.map((link) => (
            <li>
              <a
                class="nav-link"
                href={link.href}
                aria-current={active === link.id ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeSwitcher />
    </div>
  </div>
</nav>
