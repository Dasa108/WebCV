---
// Faint theme-matched decorative layer behind the Extracurriculars section
// (SPEC.md §7.6) — abstract/geometric only, no logos or emblems. All three
// variants render into the DOM; global.css shows only the one matching
// the active theme (`.extracurriculars-bg` rules) and keeps the whole
// layer low-opacity so it never competes with the mascots/content.
---

<div class="extracurriculars-bg" aria-hidden="true">
  <!-- Food Wars: steam wisps + plating splatters -->
  <svg class="bg--foodwars" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" fill="none">
    <circle cx="40" cy="150" r="10" fill="var(--bg-decoration)" />
    <circle cx="70" cy="170" r="5" fill="var(--bg-decoration)" />
    <circle cx="340" cy="40" r="14" fill="var(--bg-decoration)" />
    <circle cx="365" cy="70" r="6" fill="var(--bg-decoration)" />
    <path d="M60,140 C50,110 75,100 65,70" stroke="var(--bg-decoration)" stroke-width="4" stroke-linecap="round" />
    <path d="M90,150 C82,125 100,115 92,90" stroke="var(--bg-decoration)" stroke-width="3" stroke-linecap="round" />
    <path d="M320,60 C312,35 330,25 322,0" stroke="var(--bg-decoration)" stroke-width="4" stroke-linecap="round" />
  </svg>

  <!-- Naruto: leaf silhouettes + a chakra-spiral watermark -->
  <svg class="bg--naruto" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" fill="none">
    <g fill="var(--bg-decoration)">
      <ellipse cx="45" cy="150" rx="16" ry="8" transform="rotate(-30 45 150)" />
      <line x1="30" y1="155" x2="60" y2="145" stroke="var(--color-bg)" stroke-width="1" />
      <ellipse cx="80" cy="175" rx="11" ry="6" transform="rotate(20 80 175)" />
      <ellipse cx="345" cy="35" rx="16" ry="8" transform="rotate(35 345 35)" />
      <ellipse cx="315" cy="15" rx="10" ry="5" transform="rotate(-15 315 15)" />
    </g>
    <path
      d="M340,150 m0,-30 a30,30 0 1,1 -21,51 a20,20 0 1,1 14,-34 a10,10 0 1,1 -7,17"
      stroke="var(--bg-decoration)"
      stroke-width="3"
      stroke-linecap="round"
    />
  </svg>

  <!-- Fairy Tail: magic-circle rings + elemental sparkle particles -->
  <svg class="bg--fairytail" viewBox="0 0 400 200" preserveAspectRatio="xMidYMid slice" fill="none">
    <g stroke="var(--bg-decoration)" stroke-width="1.5">
      <circle cx="60" cy="150" r="34" />
      <circle cx="60" cy="150" r="24" />
      {Array.from({ length: 8 }).map((_, i) => {
        const angle = (i / 8) * Math.PI * 2;
        const x1 = 60 + Math.cos(angle) * 24;
        const y1 = 150 + Math.sin(angle) * 24;
        const x2 = 60 + Math.cos(angle) * 34;
        const y2 = 150 + Math.sin(angle) * 34;
        return <line x1={x1} y1={y1} x2={x2} y2={y2} />;
      })}
      <circle cx="345" cy="40" r="22" />
    </g>
    <g fill="var(--bg-decoration)">
      <path d="M310,120 l3,8 l8,3 l-8,3 l-3,8 l-3,-8 l-8,-3 l8,-3 Z" />
      <path d="M370,150 l2,5 l5,2 l-5,2 l-2,5 l-2,-5 l-5,-2 l5,-2 Z" />
      <path d="M20,40 l2.5,6 l6,2.5 l-6,2.5 l-2.5,6 l-2.5,-6 l-6,-2.5 l6,-2.5 Z" />
    </g>
  </svg>
</div>
