---
import { SITE_GITHUB, SITE_LINKEDIN } from '../lib/site';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p>© {year} Sudarshana Chaitanya B N</p>
    <ul>
      <li><a href={base}>Home</a></li>
      <li><a href={`${base}about`}>About</a></li>
      <li><a href={`${base}experience`}>Experience</a></li>
      <li><a href={`${base}projects`}>Projects</a></li>
      <li><a href={`${base}#contact`}>Contact</a></li>
      <li><a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer">GitHub</a></li>
      <li><a href={SITE_LINKEDIN} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
    </ul>
  </div>
</footer>
