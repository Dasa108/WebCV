---
import Layout from '../components/Layout.astro';
import TreeConnector from '../components/connectors/TreeConnector.astro';
import ButterConnector from '../components/connectors/ButterConnector.astro';
import WaterConnector from '../components/connectors/WaterConnector.astro';
import { getExperience } from '../lib/content';

const experience = getExperience();
---

<Layout
  title="Experience — Sudarshana Chaitanya B N"
  description="Work experience — internships, roles, and research positions."
  active="experience"
>
  <section class="container">
    <p class="eyebrow">Work Experience</p>
    <h1>Experience</h1>
    <p style="max-width: 60ch; color: var(--color-text-muted);">
      Every internship, job, or research position lives in this one
      reverse-chronological list.
    </p>

    <!-- All three themed connectors render into the DOM; global.css shows
         only the one matching the active theme (SPEC §4/§7.1), so
         switching themes re-themes this motif instantly, no JS re-render. -->
    <div style="margin-top: var(--space-3);">
      <TreeConnector experience={experience} />
      <ButterConnector experience={experience} />
      <WaterConnector experience={experience} />
    </div>
  </section>
</Layout>
